<%- include('partials/header') %><main id="main" class="container auth"><h1>CONTACTO</h1><p>¿Tenés una consulta sobre la tienda?</p><p class="muted">Este formulario es una demostración local: valida los datos sin enviar correos.</p><% if(sent){ %><div class="notice" role="status">Formulario validado correctamente. No se envió ningún correo.</div><a class="button dark" href="/shop">VOLVER AL SHOP</a><% }else{ %><% if(error){ %><p class="error" role="alert"><%= error %></p><% } %><form action="/contact" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Nombre<input name="name" required maxlength="100"></label><label>Email<input name="email" type="email" required maxlength="190"></label><label>Mensaje<textarea name="message" rows="5" required maxlength="3000"></textarea></label><button class="button red">VALIDAR CONSULTA</button></form><% } %></main><%- include('partials/footer') %>
