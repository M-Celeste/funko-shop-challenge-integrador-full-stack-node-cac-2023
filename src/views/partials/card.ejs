<article class="product-card"><a class="product-photo" href="/shop/item/<%= p.id %>"><span class="badge"><%= p.stock===0?'SIN STOCK':p.discount?'−'+p.discount+'%':'NUEVO' %></span><img class="front" src="/img/<%= p.image %>" alt="Funko Pop <%= p.name %>" loading="lazy"><img class="back" src="/img/<%= p.box %>" alt="Caja de <%= p.name %>" loading="lazy"></a><div class="card-content"><p class="licence"><%= p.licence %></p><h3><a href="/shop/item/<%= p.id %>"><%= p.name %></a></h3><p class="price"><%= money(p.price*(100-p.discount)/100) %></p><p class="installments"><%= p.installments %> CUOTAS SIN INTERÉS</p></div></article>
