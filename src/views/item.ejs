<%- include('partials/header') %><main id="main" class="container"><nav class="breadcrumb" aria-label="Ubicación"><a href="/shop">Shop</a> / <%= product.name %></nav><section class="item"><div class="gallery"><img id="main-product" src="/img/<%= product.image %>" alt="<%= product.name %>"><div class="thumbs"><button type="button" data-image="/img/<%= product.image %>" aria-label="Ver figura"><img src="/img/<%= product.image %>" alt="Figura"></button><button type="button" data-image="/img/<%= product.box %>" aria-label="Ver caja"><img src="/img/<%= product.box %>" alt="Caja"></button></div></div><div class="item-info"><p class="licence"><%= product.licence %></p><h1><%= product.name %></h1><p><%= product.description %></p><p class="item-price"><%= money(product.price*(100-product.discount)/100) %></p><p class="muted">SKU: <%= product.sku %> · Stock: <%= product.stock %></p><% if(product.stock>0){ %><form action="/shop/cart" method="post" class="add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="productId" value="<%= product.id %>"><label>Cantidad<input aria-label="Cantidad" type="number" name="quantity" value="1" min="1" max="<%= product.stock %>" required></label><button class="button red">Agregar al carrito</button></form><% }else{ %><p class="error">Sin stock por el momento.</p><% } %><p class="installments"><%= product.installments %> CUOTAS SIN INTERÉS</p><% if(!user){ %><p class="muted"><a class="text-link" href="/auth/login">Ingresá</a> o <a class="text-link" href="/auth/register">creá tu cuenta</a> para agregar productos.</p><% } %></div></section><section class="releases"><h2>PRODUCTOS RELACIONADOS</h2><div class="product-grid"><% products.forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div></section></main><%- include('partials/footer') %>
