<%- include('partials/header') %><main id="main" class="container admin"><div class="section-top"><h1>LISTADO DE PRODUCTOS</h1><a class="button red" href="/admin/create">AGREGAR +</a></div><form class="admin-search" method="get"><label class="sr-only" for="search">Buscar productos</label><input id="search" name="q" value="<%= q %>" placeholder="Código, nombre o colección"><button class="button dark">BUSCAR</button></form><p class="muted">Hola, <%= user.name %>. Los cambios se aplican al catálogo de la tienda.</p><div class="table-wrap"><table><thead><tr><th>ID</th><th>Código</th><th>Nombre del producto</th><th>Licencia</th><th>Precio</th><th>Stock</th><th>Acciones</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><%= p.id %></td><td><%= p.sku %></td><td><a href="/shop/item/<%= p.id %>"><%= p.name %></a></td><td><%= p.licence %></td><td><%= money(p.price) %></td><td><%= p.stock %></td><td><div class="row-actions"><a class="text-link" href="/admin/<%= p.id %>/edit">Editar</a><form class="confirm-delete" action="/admin/<%= p.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="delete">Eliminar</button></form></div></td></tr><% }) %></tbody></table><% if(!products.length){ %><p class="empty">No hay productos para esta búsqueda.</p><% } %></div></main><%- include('partials/footer') %>
