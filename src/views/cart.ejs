<%- include('partials/header') %><main id="main" class="container cart"><h1 class="underlined">CARRITO DE COMPRAS</h1><% if(!lines.length){ %><div class="empty"><h2>Tu próxima colección empieza acá</h2><p>Todavía no agregaste productos al carrito.</p><a class="button red" href="/shop">EXPLORAR SHOP</a></div><% }else{ %><div class="cart-head"><span>DETALLE DE PRODUCTO</span><span>CANTIDAD</span><span>TOTAL</span><span></span></div><% lines.forEach(l=>{ %><article class="cart-row"><div class="cart-product"><img src="/img/<%= l.product.image %>" alt="<%= l.product.name %>"><div><h2><a href="/shop/item/<%= l.product.id %>"><%= l.product.name %></a></h2><p><%= l.product.licence %></p><p>Precio unitario: <%= money(l.product.price*(100-l.product.discount)/100) %></p><% if(l.quantity>l.product.stock){ %><p class="error">El stock cambió. Disponibles: <%= l.product.stock %>.</p><% } %></div></div><form action="/shop/cart/<%= l.id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr-only" for="qty-<%= l.id %>">Cantidad de <%= l.product.name %></label><input id="qty-<%= l.id %>" type="number" name="quantity" min="0" max="<%= l.product.stock %>" value="<%= l.quantity %>" required><button class="text-link">Actualizar</button></form><strong><%= money(l.subtotal) %></strong><form action="/shop/cart/<%= l.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="delete" aria-label="Eliminar <%= l.product.name %>">×</button></form></article><% }) %><section class="summary"><h2 class="underlined">RESUMEN</h2><div class="summary-box"><p>CANTIDAD DE ELEMENTOS <strong><%= lines.reduce((s,l)=>s+l.quantity,0) %></strong></p><p>SUBTOTAL <strong><%= money(total) %></strong></p><p>ENVÍO <strong><%= money(0) %></strong></p><p class="total">TOTAL <strong><%= money(total) %></strong></p></div><p class="muted">Demostración educativa: el alcance del challenge llega al subtotal. No se realizan cobros.</p><a class="button red" href="/shop">SEGUIR COMPRANDO</a></section><% } %></main><%- include('partials/footer') %>
