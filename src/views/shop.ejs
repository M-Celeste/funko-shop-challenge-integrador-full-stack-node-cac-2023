<%- include('partials/header') %><main id="main" class="container shop-layout"><aside><h1 class="small-title">SHOP</h1><form method="get" action="/shop" class="filters"><label>BUSCAR<input name="q" value="<%= q %>" placeholder="Producto o código"></label><label>ORDENAR POR<select name="sort"><% [['new','Más recientes'],['price-asc','Menor precio'],['price-desc','Mayor precio'],['name','Nombre A–Z']].forEach(([v,t])=>{ %><option value="<%= v %>" <%= query.sort===v?'selected':'' %>><%= t %></option><% }) %></select></label><fieldset><legend>PRECIO</legend><div class="price-range"><label>Mín.<input type="number" name="min" min="0" value="<%= query.min||'' %>"></label><label>Máx.<input type="number" name="max" min="0" value="<%= query.max||'' %>"></label></div></fieldset><label>COLECCIÓN<select name="licence"><option value="">Todas las colecciones</option><% ['STAR WARS','POKÉMON','HARRY POTTER','NARUTO'].forEach(l=>{ %><option <%= licence===l?'selected':'' %>><%= l %></option><% }) %></select></label><label>CATEGORÍA<select name="category"><option value="">Todas</option><% ['Figuras','Remeras','Llaveros'].forEach(l=>{ %><option <%= category===l?'selected':'' %>><%= l %></option><% }) %></select></label><label class="check"><input name="available" type="checkbox" value="1" <%= query.available?'checked':'' %>> En stock</label><label class="check"><input name="sale" type="checkbox" value="1" <%= query.sale?'checked':'' %>> Ofertas</label><button class="button red">APLICAR FILTROS</button><a class="text-link" href="/shop">Limpiar filtros</a></form></aside><section><div class="section-top"><h2>Coleccioná tus favoritos</h2><span><%= products.length %> productos</span></div><% if(!products.length){ %><div class="empty"><h2>No encontramos productos</h2><p>Probá con otra búsqueda o colección.</p><a href="/shop" class="button dark">Ver todos</a></div><% } %><div class="product-grid"><% products.forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div></section></main><%- include('partials/footer') %>
