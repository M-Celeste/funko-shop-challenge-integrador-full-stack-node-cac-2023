<%- include('partials/header') %><main id="main" class="container auth"><h1><%= register?'CREÁ TU CUENTA':'INGRESAR A MI CUENTA' %></h1><p><%= register?'Completá el formulario para ser parte del mundo de los coleccionables.':'¡Qué bueno verte de nuevo!' %></p><% if(error){ %><p class="error" role="alert"><%= error %></p><% } %><form action="/auth/<%= register?'register':'login' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(register){ %><label>Nombre y apellido<input name="name" autocomplete="name" maxlength="100" required value="<%= values.name||'' %>"></label><% } %><label>Email<input type="email" name="email" autocomplete="email" maxlength="190" required value="<%= values.email||'' %>"></label><label>Contraseña<input name="password" type="password" autocomplete="<%= register?'new-password':'current-password' %>" minlength="8" maxlength="128" required></label><% if(register){ %><label>Repetir contraseña<input name="confirm" type="password" autocomplete="new-password" minlength="8" required></label><label class="check"><input type="checkbox" name="terms" required> Acepto las <a class="text-link" href="/terms">condiciones de uso</a></label><% } %><button class="button red"><%= register?'Registrarme':'Ingresar' %></button></form><p><a class="text-link" href="/auth/<%= register?'login':'register' %>"><%= register?'Ya tengo cuenta':'Crear una cuenta nueva' %></a></p></main><%- include('partials/footer') %>
