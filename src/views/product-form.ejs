<%- include('partials/header') %><main id="main" class="container product-editor"><h1><%= product.id?'EDITAR ÍTEM':'CREAR NUEVO ÍTEM' %></h1><% if(error){ %><p class="error" role="alert"><%= error %></p><% } %><form enctype="multipart/form-data" method="post" action="/admin/<%= product.id?product.id+'/edit':'create' %>" class="editor-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="two-col"><label>Categoría<select name="category" required><% ['Figuras','Remeras','Llaveros'].forEach(c=>{ %><option <%= product.category===c?'selected':'' %>><%= c %></option><% }) %></select></label><label>Licencia<input name="licence" required maxlength="100" value="<%= product.licence||'' %>" list="licences"><datalist id="licences"><option>STAR WARS</option><option>POKÉMON</option><option>HARRY POTTER</option><option>NARUTO</option></datalist></label></div><label>Nombre del producto<input name="name" maxlength="100" required value="<%= product.name||'' %>"></label><label>Descripción<textarea name="description" rows="4" maxlength="3000" required><%= product.description||'' %></textarea></label><div class="two-col"><label>SKU<input name="sku" required maxlength="100" value="<%= product.sku||'' %>"></label><label>Precio ($)<input name="price" type="number" step="0.01" min="0.01" max="99999999" required value="<%= product.price||'' %>"></label><label>Stock<input name="stock" type="number" min="0" max="100000" required value="<%= product.stock??0 %>"></label><label>Descuento (%)<input name="discount" type="number" min="0" max="90" required value="<%= product.discount??0 %>"></label><label>Cuotas<input name="installments" type="number" min="1" max="24" required value="<%= product.installments||3 %>"></label></div><fieldset><legend>IMÁGENES DEL PRODUCTO</legend><p class="muted">Subí imágenes PNG, JPG o WebP de hasta 3 MB, o usá rutas existentes de public/img.</p><label>Subir imagen frontal<input type="file" name="frontFile" accept="image/png,image/jpeg,image/webp"></label><label>Ruta imagen frontal<input name="image" value="<%= product.image||'' %>" placeholder="pokemon/pikachu-1.webp"></label><label>Subir imagen de caja<input type="file" name="boxFile" accept="image/png,image/jpeg,image/webp"></label><label>Ruta imagen de caja<input name="box" value="<%= product.box||'' %>" placeholder="pokemon/pikachu-box.webp"></label></fieldset><div class="row-actions"><button class="button red">GUARDAR PRODUCTO</button><a class="button dark" href="/admin">CANCELAR</a></div></form></main><%- include('partials/footer') %>
